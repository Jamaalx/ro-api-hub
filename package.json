{
  "name": "ro-api-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The comprehensive open-source library of Romanian APIs — keys, sandbox credentials, OpenAPI specs, SDKs, tutorials and MCP wrappers in one place.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "predev": "node scripts/build-catalog.mjs --public-only",
    "prebuild": "node scripts/build-catalog.mjs --public-only",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "catalog": "node scripts/build-catalog.mjs",
    "check:catalog": "node scripts/build-catalog.mjs --check",
    "check:apis": "node scripts/check-apis.mjs --report reports/links-latest.md",
    "check:links": "node scripts/check-dist-links.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.2.9",
    "sharp": "^0.35.4",
    "starlight-llms-txt": "^0.11.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
