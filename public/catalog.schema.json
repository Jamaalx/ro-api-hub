{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jamaalx/ro-api-hub/main/public/catalog.schema.json",
  "title": "ro-api-hub catalog",
  "description": "Machine-readable index of the ro-api-hub catalogue, generated by scripts/build-catalog.mjs from the frontmatter of src/content/docs/apis/**.",
  "type": "object",
  "required": [
    "name",
    "count",
    "services"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "const": "ro-api-hub"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "site_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Public URL of the static site this copy was built for; null in the copy committed to the repo root."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "category",
        "sector",
        "status",
        "auth",
        "official_docs",
        "source_url"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable identifier; also the page path and file name."
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "fiscal",
            "finance",
            "registry",
            "stats",
            "geo",
            "health",
            "transport",
            "justice",
            "identity",
            "gov",
            "opendata",
            "procurement",
            "elections",
            "regulators",
            "banks",
            "payments",
            "couriers",
            "telecom",
            "marketplaces",
            "sms",
            "invoicing",
            "maps",
            "jobs",
            "energy",
            "insurance",
            "aggregator",
            "community",
            null
          ]
        },
        "sector": {
          "enum": [
            "public",
            "private",
            "aggregators",
            "community"
          ],
          "description": "Top-level folder under src/content/docs/apis/."
        },
        "institution": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "active",
            "stale",
            "broken",
            "suspended",
            "gated",
            null
          ],
          "description": "active = usable; stale = outdated or its documented host is gone; broken = no public API (scraping notes only); suspended = service down; gated = needs contract/certificate/partnership."
        },
        "auth": {
          "type": [
            "string",
            "null"
          ],
          "description": "none | api_key | oauth2 | basic_auth | qualified_cert | contract | mtls"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "sandbox_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "contract_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "openapi_spec": {
          "enum": [
            true,
            false,
            "partial",
            null
          ]
        },
        "pricing": {
          "type": [
            "string",
            "null"
          ]
        },
        "official_docs": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "First URL found in the official_docs frontmatter field."
        },
        "api_base_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "First URL found in api_base_url; null when the file says unknown / per-tenant / etc."
        },
        "api_base_url_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "The raw api_base_url text when it is not a URL (e.g. \"unknown\", \"per-tenant\")."
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date a human actually tested the API."
        },
        "links_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date scripts/check-apis.mjs last saw all declared URLs answer. Does not mean the API was tested."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "The Markdown file on GitHub."
        },
        "page_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Page on the static site; null in the repo-root copy (site not published)."
        }
      }
    }
  }
}
